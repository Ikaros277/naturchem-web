{
  "name": "naturchem-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/generate_runtime_styles.js",
    "dev": "next dev",
    "predev:webpack": "node scripts/generate_runtime_styles.js",
    "dev:webpack": "next dev --webpack",
    "preview": "npm run build && next start",
    "prebuild": "node scripts/verify_public_assets.js && node scripts/verify_immutable_assets.js && node scripts/generate_article_indexes.js && node scripts/generate_responsive_images.js && node scripts/generate_runtime_styles.js",
    "build": "next build",
    "postbuild": "node scripts/verify_rendered_cache_budget.js && node scripts/verify_rendered_performance.js && node scripts/verify_runtime_styles.js --rendered && node scripts/verify_mobile_performance.js --rendered",
    "images:prepare": "node scripts/generate_responsive_images.js",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test:contact-prefill": "node scripts/verify_contact_prefill.js",
    "test:cache-budget": "node scripts/verify_cache_budget.js",
    "test:article-routing": "node scripts/verify_article_routing.js",
    "test:contact-delivery": "node scripts/verify_contact_delivery.js",
    "test:publication": "node scripts/verify_publication.js",
    "test:public-assets": "node scripts/verify_public_assets.js",
    "test:b2b": "node scripts/verify_b2b.js",
    "test:audit-quality": "node scripts/verify_audit_quality.js",
    "test:authentic-photos": "node scripts/verify_authentic_photos.js",
    "test:immutable-assets": "node scripts/verify_immutable_assets.js",
    "test:performance": "node scripts/verify_performance.js && node scripts/verify_mobile_performance.js",
    "test:runtime-styles": "node scripts/generate_runtime_styles.js && node scripts/verify_runtime_styles.js",
    "preverify": "node scripts/generate_article_indexes.js && node scripts/generate_responsive_images.js",
    "publication:check": "node scripts/scheduled_publication.js --check",
    "verify": "npm run lint && npm run typecheck && npm run test:contact-prefill && npm run test:cache-budget && npm run test:article-routing && npm run test:contact-delivery && npm run test:publication && npm run test:public-assets && npm run test:b2b && npm run test:audit-quality && npm run test:authentic-photos && npm run test:performance && npm run build",
    "seo:smoke-sitemap": "python scripts/smoke_test_urls.py https://www.naturchem.cz",
    "seo:smoke-local": "python scripts/smoke_test_urls.py http://localhost:3000",
    "seo:smoke-routing-local": "python scripts/smoke_test_routing.py http://localhost:3000",
    "seo:gsc-report": "python scripts/gsc_monthly_report.py",
    "seo:gsc-404-import": "python scripts/gsc_import_404_redirects.py"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "gray-matter": "^4.0.3",
    "next": "^16.2.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "postcss": "8.4.31",
    "typescript": "^5"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4"
  ]
}
